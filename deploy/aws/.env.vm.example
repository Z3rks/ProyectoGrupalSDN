# Copie como deploy/aws/.env.vm en cada VM y complete. NUNCA lo suba a git.
NODE_INDEX=1                 # 1 en VM-1, 2 en VM-2, 3 en VM-3
VM_IP=10.0.1.11              # IP privada de ESTA VM
IP1=10.0.1.11                # IPs privadas de VM-1, VM-2 y VM-3 (iguales en las tres)
IP2=10.0.1.12
IP3=10.0.1.13

# Iguales en las tres VM (genere una vez con `openssl rand -hex 32` y cópielos):
DFSHA_JWT_SECRET=cambiar
DFSHA_CAP_KEY=cambiar
DFSHA_ADMIN_PASSWORD=cambiar

# DISTINTA en cada VM (clave AES-256 del nodo de datos: 64 caracteres hexadecimales):
DFSHA_MASTER_KEY=cambiar
